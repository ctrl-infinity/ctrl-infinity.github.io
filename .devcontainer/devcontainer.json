{
  "name": "ctrl-infinity.github.io (Astro)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  // Persists Claude Code auth/settings/history across container rebuilds
  // (plain stop/start already persists it, but a rebuild wipes the home dir otherwise).
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume"
  ],

  // Runs once when the codespace/container is first created.
  "postCreateCommand": "bash .devcontainer/setup.sh",

  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": {
      "label": "Astro dev server",
      "onAutoForward": "openPreview"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "bradlc.vscode-tailwindcss",
        "james-yu.latex-workshop"
      ],
      "settings": {
        "files.associations": {
          "*.astro": "astro"
        }
      }
    }
  },

  "remoteUser": "node"
}
