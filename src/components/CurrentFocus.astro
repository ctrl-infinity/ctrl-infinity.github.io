---
import type { CollectionEntry } from 'astro:content';
import { formatWorkStatus } from '../lib/work';

interface Props {
  entries: CollectionEntry<'now'>[];
  projects: CollectionEntry<'work'>[];
}
const { entries, projects } = Astro.props;
const ordered = [...entries].sort((a, b) => a.data.order - b.data.order).map(({ data }) => {
  const projectId = data.link?.match(/^\/work\/([^/?#]+)\/?$/)?.[1];
  const project = projectId ? projects.find(({ id }) => id === projectId) : undefined;
  if (projectId && !project) throw new Error(`Current note references missing work: ${projectId}`);
  return { data, project: project?.data };
});
const labels = { active: 'Active', exploring: 'Exploring', paused: 'On the shelf' };
const formatDate = (date: string) => new Date(`${date}T00:00:00Z`).toLocaleDateString('en-US', {
  month: 'short', year: 'numeric', timeZone: 'UTC',
});
---

<section class="section-rule editorial-split" id="currently" aria-labelledby="currently-heading">
  <div class="section-intro">
    <h2 id="currently-heading">Currently</h2>
    <p class="current-intro">A small, manually maintained notebook of what's on my desk. Open a note for the details.</p>
    <a class="text-link" href="/playground">Try a small experiment &rarr;</a>
  </div>
  <div class="current-notes">
    {ordered.length === 0 ? <p class="human-note">No current notes published.</p> : ordered.map(({ data, project }) => (
      <details>
        <summary>
          <span class="current-title">{project?.title ?? data.title}</span>
          <span class="metadata">
            <span>{labels[data.status]}</span>
            {data.updated && <time datetime={data.updated}>Reviewed {formatDate(data.updated)}</time>}
          </span>
        </summary>
        <div class="current-detail">
          <p>{data.description}</p>
          {project?.status
            ? <p class="metadata">{formatWorkStatus(project.status, project.duration)}</p>
            : (project?.duration ?? data.startDate) && <p class="metadata">Since {project?.duration ?? data.startDate}</p>}
          {project?.evidence && <p>{project.evidence}</p>}
          <p class="metadata">{data.tags.join(' / ')}</p>
          {data.link && (
            <a class="text-link" href={data.link} target={!data.link.startsWith('/') ? '_blank' : undefined} rel={!data.link.startsWith('/') ? 'noopener noreferrer' : undefined}>Inside the work &rarr;</a>
          )}
        </div>
      </details>
    ))}
  </div>
</section>
