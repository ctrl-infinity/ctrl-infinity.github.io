---
import type { CollectionEntry } from 'astro:content';

interface Props { entries: CollectionEntry<'now'>[]; }
const { entries } = Astro.props;
const ordered = [...entries].sort((a, b) => a.data.order - b.data.order);
const labels = { active: 'Building & operating', exploring: 'Exploring', paused: 'On the shelf' };
const formatDate = (date: string) => new Date(`${date}T00:00:00Z`).toLocaleDateString('en-US', {
  day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
});
---

<section class="section-rule editorial-split" id="currently" aria-labelledby="currently-heading">
  <div class="section-intro">
    <h2 id="currently-heading">Currently</h2>
    <p class="current-intro">A small, manually maintained notebook of what's on my desk. Open a note for the details.</p>
    <a class="text-link" href="/playground">Try a small experiment &rarr;</a>
  </div>
  <div class="current-notes">
    {ordered.length === 0 ? <p class="human-note">No current notes published.</p> : ordered.map(({ data }) => (
      <details>
        <summary>
          <span class="current-title">{data.title}</span>
          <span class="metadata">
            <span>{labels[data.status]}</span>
            {data.updated && <time datetime={data.updated}>Reviewed {formatDate(data.updated)}</time>}
          </span>
        </summary>
        <div class="current-detail">
          <p>{data.description}</p>
          {data.startDate && <p class="metadata">Since {data.startDate}</p>}
          <p class="metadata">{data.tags.join(' / ')}</p>
          {data.link && (
            <a class="text-link" href={data.link} target={!data.link.startsWith('/') ? '_blank' : undefined} rel={!data.link.startsWith('/') ? 'noopener noreferrer' : undefined}>Inside the work &rarr;</a>
          )}
        </div>
      </details>
    ))}
  </div>
</section>
