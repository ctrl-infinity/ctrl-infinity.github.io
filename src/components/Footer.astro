---
import resume from '../content/resume.json';
---

<footer class="site-shell contact-footer">
  <div class="contact-heading">
    <h2>Have a problem worth solving?</h2>
    <a class="text-link" href={`mailto:${resume.basics.email}`}>Get in touch &nearr;</a>
  </div>
  <div class="footer-meta">
    <a href={`mailto:${resume.basics.email}`}>{resume.basics.email}</a>
    <nav aria-label="Social and utility links">
      <a href={resume.basics.github} target="_blank" rel="noopener noreferrer">GitHub &nearr;</a>
      <a href={resume.basics.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn &nearr;</a>
      <a href="/resume">Resume &nearr;</a>
      <a href="#top">Top &uarr;</a>
    </nav>
  </div>
</footer>
