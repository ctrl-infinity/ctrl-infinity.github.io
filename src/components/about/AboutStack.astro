---
const stack = [
  {
    category: "Generative AI & ML",
    items: [
      { name: "Retrieval-Augmented Generation (RAG)", note: "custom vector indexing & prompt flow" },
      { name: "Large Language Models (LLMs)", note: "evaluation & fine-tuning" },
      { name: "Multi-Agent Systems", note: "Agent2Agent (A2A) protocol, cross-team orchestration" },
      { name: "Autonomous AI Agents", note: "Claude Code, agentic CI/CD workflows" },
      { name: "Prompt Flow", note: "orchestration & load balancing" },
      { name: "TensorFlow & PyTorch", note: "deep learning models" },
      { name: "Computer Vision & NLP", note: "YOLO, OpenCV, GloVe embeddings" },
    ],
  },
  {
    category: "Cloud / LLMOps",
    items: [
      { name: "Azure & Azure ML SDK", note: "workspace & endpoint deployments" },
      { name: "Azure DevOps", note: "multi-environment CI/CD, service hooks" },
      { name: "Azure Container Apps & Cosmos DB", note: "multi-tenant platform hosting" },
      { name: "OpenTelemetry", note: "cross-service distributed tracing" },
      { name: "Docker & Kubernetes", note: "containerized microservices" },
      { name: "Terraform & Bicep", note: "infrastructure as code" },
    ],
  },
  {
    category: "Data Engineering",
    items: [
      { name: "PySpark & Databricks", note: "high-throughput analytics pipelines" },
      { name: "Azure Data Factory", note: "ETL & automated data ingestion" },
      { name: "SQL & PostreSQL", note: "data modeling & transformations" },
      { name: "Power BI", note: "automated executive reporting" },
    ],
  },
  {
    category: "Programming & Web",
    items: [
      { name: "Python", note: "primary language for AI/ML & scripting" },
      { name: "C# / .NET", note: "Microsoft Agent Framework services" },
      { name: "JavaScript / TypeScript", note: "web applications & tools" },
      { name: "Go", note: "high-performance backend services" },
      { name: "Astro & React", note: "content & interactive interfaces" },
    ],
  },
];
---

<section class="mb-24">
  <h2 class="text-2xl font-bold tracking-tight text-foreground mb-8">What I Work With</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
    {stack.map((group) => (
      <div>
        <h3 class="text-xs font-mono uppercase tracking-[0.15em] text-gray-400 mb-4">
          {group.category}
        </h3>
        <ul class="space-y-3">
          {group.items.map((item) => (
            <li class="text-foreground">
              <span class="font-medium">{item.name}</span>
              {item.note && (
                <span class="text-gray-500 text-sm"> — {item.note}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
