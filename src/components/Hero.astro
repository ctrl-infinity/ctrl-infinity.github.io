---
import resume from '../content/resume.json';
---

<section class="home-hero">
  <div>
    <h1>I'm Vinayak.</h1>
    <p class="hero-statement">I build AI agents for real team workflows.</p>
    <p class="hero-role">{resume.basics.label}</p>
    <p class="hero-employment">{resume.experience[0].role} at {resume.experience[0].company}.</p>
  </div>
  <div class="hero-copy">
    <p>I learn by building, and care about what happens after the code is written. My work spans an AI reviewer in active team use and a multi-agent platform in UAT.</p>
    <p>{resume.basics.location}. {resume.basics.opportunities}</p>
    <div class="actions">
      <a class="button" href="/work">See the work</a>
      <a class="text-link" href={`mailto:${resume.basics.email}`}>Get in touch &nearr;</a>
    </div>
  </div>
</section>
