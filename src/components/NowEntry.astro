---
export interface Props {
  title: string;
  description: string;
  tags: string[];
  startDate?: string;
  link?: string;
}

const { title, description, tags, startDate, link } = Astro.props;
---

<div class="bento-tile p-6 rounded-[16px] my-3 flex flex-col gap-3 transition-all duration-300" data-reveal>
  <div class="flex items-baseline justify-between gap-4">
    <h3 class="text-lg font-bold text-foreground">
      {
        link ? (
          <a
            href={link}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-accent transition-colors duration-300"
          >
            {title} ↗
          </a>
        ) : (
          title
        )
      }
    </h3>
    {
      startDate && (
        <span class="text-xs font-mono text-gray-500 shrink-0">{startDate}</span>
      )
    }
  </div>

  <p class="text-gray-600 leading-relaxed max-w-[65ch]">
    {description}
  </p>

  <div class="flex flex-wrap gap-2 mt-2 pt-3 border-t border-black/5">
    {
      tags.map((tag) => (
        <span class="chip">
          {tag}
        </span>
      ))
    }
  </div>
</div>

<script>
  import { setupReveal } from '../scripts/reveal';
  setupReveal();
</script>
