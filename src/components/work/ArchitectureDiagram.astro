---
interface Step {
  title: string;
  description: string;
  status?: 'live' | 'planned';
}

interface Phase {
  name: string;
  steps: Step[];
}

interface Props {
  phases: Phase[];
  caption?: string;
}

const { phases, caption } = Astro.props;
---

<figure class="my-12 space-y-10" data-reveal>
  {phases.map((phase) => (
    <div>
      <h3 class="font-mono text-xs uppercase tracking-wider text-gray-500 mb-5">{phase.name}</h3>
      <div class="relative">
        <div class="absolute left-1 top-1 bottom-1 w-px bg-black/10" />
        <div class="space-y-5">
          {phase.steps.map((step) => {
            const planned = step.status === 'planned';
            return (
              <div class="relative pl-8">
                <div class={`absolute left-0 top-1.5 w-2 h-2 rounded-full ${planned ? 'border border-gray-300' : 'bg-foreground'}`} />
                <div class="flex items-baseline gap-2 flex-wrap">
                  <span class={`text-sm font-medium ${planned ? 'text-gray-500' : 'text-foreground'}`}>{step.title}</span>
                  {planned && (
                    <span class="text-[0.65rem] font-mono uppercase tracking-wider text-gray-400">planned</span>
                  )}
                </div>
                <p class="text-sm text-gray-600 leading-relaxed mt-1 max-w-[58ch]">{step.description}</p>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  ))}
  {caption && (
    <figcaption class="text-xs font-mono text-gray-500 pt-2 border-t border-black/10">
      {caption}
    </figcaption>
  )}
</figure>
