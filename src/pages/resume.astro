---
import Layout from '../layouts/Layout.astro';
import resumeData from '../content/resume.json';

const pdfPath = '/resume/vinayak-gupta-resume.pdf';
const sections = ['Experience', 'Projects', 'Skills', 'Education'];
const formatHighlight = (text: string) => {
  return text.replace(/\*\*(.*?)\*\*/g, '<strong class="font-semibold text-foreground">$1</strong>');
};
---

<Layout title="Resume — Vinayak Gupta" description="Vinayak Gupta's resume. Software Engineer & ML Engineer.">
  <div class="site-shell page-content resume-page">
    <header class="page-heading">
      <h1>Resume</h1>
      <div class="actions resume-actions">
        <a href={pdfPath} download class="button">Download PDF <span aria-hidden="true">&darr;</span></a>
        <a href="/work" class="text-link">Explore the work &rarr;</a>
      </div>
    </header>

    <section class="section-rule editorial-split resume-overview" aria-labelledby="resume-name">
      <div>
        <h2 id="resume-name" class="project-title">{resumeData.basics.name}</h2>
        <div class="metadata resume-contact">
          <span>{resumeData.basics.location}</span>
          <a href={`mailto:${resumeData.basics.email}`} class="text-link">{resumeData.basics.email}</a>
        </div>
      </div>
      <p class="human-note" set:html={formatHighlight(resumeData.basics.summary)} />
    </section>

    <nav class="text-links resume-sections" aria-label="Resume sections">
      {sections.map((section) => <a href={`#resume-${section.toLowerCase()}`}>{section} &darr;</a>)}
    </nav>

    <section class="section-rule" id="resume-experience" aria-labelledby="experience-title">
      <div class="section-top"><h2 id="experience-title">Experience</h2></div>
      <div class="resume-entries">
        {resumeData.experience.map((job) => (
          <article class="editorial-card editorial-card--stationary resume-entry">
            <div class="resume-entry-meta">
              <p class="resume-company">{job.company}</p>
              <div class="metadata"><span>{job.startDate} — {job.endDate}</span><span>{job.location}</span></div>
            </div>
            <div class="resume-entry-body">
              <h3>{job.role}</h3>
              <ul class="resume-highlights">
                {job.highlights.map((highlight) => <li set:html={formatHighlight(highlight)} />)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section-rule" id="resume-projects" aria-labelledby="projects-title">
      <div class="section-top"><h2 id="projects-title">Projects</h2><a href="/work">All work &rarr;</a></div>
      <div class="work-gallery">
        {resumeData.projects.map((project) => (
          <article class="editorial-card editorial-card--stationary resume-project project-story">
            <h3 class="project-title">{project.title}</h3>
            <div class="metadata" aria-label="Technologies">{project.technologies.join(' / ')}</div>
            <p set:html={formatHighlight(project.description)} />
            {project.github && (
              <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-link">
                View on GitHub <span aria-hidden="true">&nearr;</span><span class="sr-only"> (opens in a new tab)</span>
              </a>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="section-rule" id="resume-skills" aria-labelledby="skills-title">
      <div class="section-top"><h2 id="skills-title">Skills</h2></div>
      <dl class="resume-skills">
        {resumeData.skills.map((group) => (
          <div class="resume-entry">
            <dt>{group.category}</dt>
            <dd>{group.items.join(' / ')}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="section-rule" id="resume-education" aria-labelledby="education-title">
      <div class="section-top"><h2 id="education-title">Education</h2></div>
      <div class="resume-entries">
        {resumeData.education.map((education) => (
          <article class="editorial-card editorial-card--stationary resume-entry">
            <div class="resume-entry-meta metadata">
              <span>{education.startDate} — {education.endDate}</span>
              <span>{education.location}</span>
            </div>
            <div class="resume-entry-body">
              <h3>{education.school}</h3>
              <p>{education.degree}</p>
              <p class="metadata">GPA: {education.gpa}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</Layout>
