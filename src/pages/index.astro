---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { getCollection } from 'astro:content';

const workCollection = await getCollection('work');
const featuredWork = workCollection
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<Layout title="Vinayak Gupta — Senior Software Engineer (MLOps)">
  <Hero />

  <section class="px-6 md:px-12 max-w-7xl mx-auto pb-24 border-t border-black/10 pt-16">
    <div class="flex items-center justify-between mb-12">
      <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-gray-500">
        Featured Production Work
      </h2>
      <a href="/work" class="text-sm font-mono text-gray-500 hover:text-accent transition-colors duration-300">
        View all work ({workCollection.length}) →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      {featuredWork.map((project) => (
        <article class="flex flex-col gap-4">
          <span class="text-xs font-mono uppercase text-gray-400">{project.data.category}</span>
          <h3 class="text-xl font-bold tracking-tight text-foreground">
            <a href={`/work/${project.id}`} class="hover:text-accent transition-colors duration-300">
              {project.data.title}
            </a>
          </h3>
          <p class="text-sm text-gray-600 leading-relaxed max-w-[45ch]">
            {project.data.description}
          </p>
          <div class="flex flex-wrap gap-2 mt-auto pt-4">
            {project.data.tags.slice(0, 3).map((tag: string) => (
              <span class="px-2 py-0.5 bg-black/5 text-xs font-mono text-foreground/80">
                {tag}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
