---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import WorkingPrinciples from '../components/WorkingPrinciples.astro';
import CurrentFocus from '../components/CurrentFocus.astro';
import AboutOutside from '../components/about/AboutOutside.astro';
import { getCollection } from 'astro:content';
import { formatWorkStatus } from '../lib/work';

const [work, now] = await Promise.all([getCollection('work'), getCollection('now')]);
const selectedWork = ['code-review-agent', 'multi-agent-orchestration-platform'].map((id) => {
  const project = work.find((entry) => entry.id === id);
  if (!project) throw new Error(`The homepage requires the ${id} case study.`);
  return project;
});
const supportingWork = work.find((entry) => entry.id === 'mobile-payments-rag');
if (!supportingWork) throw new Error('The homepage requires the mobile-payments-rag case study.');
---

<Layout title="Vinayak Gupta — Curious by default. Useful by intention." description="Vinayak Gupta, AI Engineer. An AI reviewer in active team use, a multi-agent platform in UAT, and the decisions behind them. Open to roles in India and internationally.">
  <div class="site-shell">
    <Hero />
    <section class="section-rule selected-work" id="selected-work" aria-labelledby="selected-work-heading">
      <div class="section-top"><h2 id="selected-work-heading">Selected work</h2><a href="/work">All work &rarr;</a></div>
      <div class="work-gallery">
        {selectedWork.map((project) => (
          <article class="editorial-card project-story">
            <h3 class="project-title"><a href={`/work/${project.id}`}>{project.data.title}</a></h3>
            {project.data.status && <div class="metadata">{formatWorkStatus(project.data.status, project.data.duration)}</div>}
            <p>{project.data.summary ?? project.data.description}</p>
            {project.data.evidence && <p class="project-evidence">{project.data.evidence}</p>}
            <a class="text-link" href={`/work/${project.id}`}>Inside the project &rarr;</a>
          </article>
        ))}
      </div>
      <div class="selected-work-supporting">
        <h3><a class="text-link" href={`/work/${supportingWork.id}`}>{supportingWork.data.title} &rarr;</a></h3>
        <p>{supportingWork.data.outcome}</p>
      </div>
    </section>
    <WorkingPrinciples />
    <CurrentFocus entries={now} projects={work} />
    <div class="section-rule" id="beyond-code"><AboutOutside /></div>
  </div>
</Layout>
