---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import WorkingPrinciples from '../components/WorkingPrinciples.astro';
import CurrentFocus from '../components/CurrentFocus.astro';
import AboutOutside from '../components/about/AboutOutside.astro';
import { getCollection } from 'astro:content';

const [work, now] = await Promise.all([getCollection('work'), getCollection('now')]);
const selectedWork = ['code-review-agent', 'story-to-pr'].map((id) => {
  const project = work.find((entry) => entry.id === id);
  if (!project) throw new Error(`The homepage requires the ${id} case study.`);
  return project;
});
---

<Layout title="Vinayak Gupta — Curious by default. Useful by intention." description="Meet Vinayak Gupta, a software engineer at SimCorp. How I learn, take ownership, and work with people to turn unclear problems into useful solutions.">
  <!-- THESIS: Introduce the person before presenting project evidence.
    OWN-WORLD: Paper, ink, Geist, thin rules, and subtle editorial card depth.
    STORY: Meet Vinayak, understand his approach, sample the work, see what is current.
    FIRST VIEWPORT: Name, actual role, personal introduction, and approach; no project panels.
    FORM: Approved Home/About merge with compact work previews and a small current notebook. -->
  <div class="site-shell">
    <Hero />
    <WorkingPrinciples />
    <section class="section-rule selected-work" id="selected-work" aria-labelledby="selected-work-heading">
      <div class="section-top"><h2 id="selected-work-heading">A little of what I've built</h2><a href="/work">All work &rarr;</a></div>
      <div class="work-gallery">
        {selectedWork.map((project) => (
          <article class="editorial-card project-story">
            <h3 class="project-title"><a href={`/work/${project.id}`}>{project.data.title}</a></h3>
            <p>{project.data.summary ?? project.data.description}</p>
            <a class="text-link" href={`/work/${project.id}`}>Inside the project &rarr;</a>
          </article>
        ))}
      </div>
    </section>
    <CurrentFocus entries={now} />
    <div class="section-rule" id="beyond-code"><AboutOutside /></div>
  </div>
</Layout>
