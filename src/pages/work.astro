---
import Layout from '../layouts/Layout.astro';
import { WorkPage } from '../components/WorkPage';
import { WorkCard } from '../components/WorkCard';
import { getCollection } from 'astro:content';

const workCollection = await getCollection('work');
const sortedWork = workCollection
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    summary: entry.data.summary,
    contribution: entry.data.contribution,
    outcome: entry.data.outcome,
    evidence: entry.data.evidence,
    visual: entry.data.visual,
    status: entry.data.status,
    role: entry.data.role,
    category: entry.data.category,
    tags: entry.data.tags,
    image: entry.data.image,
    client: entry.data.client,
    duration: entry.data.duration,
    slug: entry.id,
    hasDetail: !!entry.body?.trim(),
    featured: entry.data.featured,
    earlier: entry.data.earlier,
  }));
const otherWork = sortedWork.filter((project) => project.category !== 'professional');
const earlierLinks = [{ title: 'Image Segmentation', href: 'https://github.com/ctrl-infinity/custom_image_segmentation' }];
---

<Layout title="Work — Vinayak Gupta" description="Things I've built — professional work, side projects, and open source.">
  <WorkPage projects={sortedWork} earlierLinks={earlierLinks} client:load />
  <noscript>
    <section class="site-shell work-noscript">
      <details class="earlier-work">
        <summary>Other work ({otherWork.length} projects)</summary>
        <p>Professional work is shown above. These earlier projects are available without JavaScript.</p>
        <div class="work-gallery">
          {otherWork.map((project) => <WorkCard {...project} compact />)}
        </div>
        <p class="earlier-links">Also on GitHub: {earlierLinks.map(link => (
          <a class="text-link" href={link.href} target="_blank" rel="noopener noreferrer">{link.title} &nearr;</a>
        ))}</p>
      </details>
    </section>
  </noscript>
</Layout>
