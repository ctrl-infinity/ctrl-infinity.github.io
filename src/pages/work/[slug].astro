---
import Layout from '../../layouts/Layout.astro';
import ReviewSystem from '../../components/work/ReviewSystem.astro';
import { ProjectVisual } from '../../components/work/ProjectVisual';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.filter((entry) => entry.body?.trim()).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props { entry: CollectionEntry<'work'>; }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, description, summary, contribution, visual, status, role, client, duration, tags, metrics, facts, problem, outcome } = entry.data;
const isReview = entry.id === 'code-review-agent';
---

<Layout title={`${title} — Vinayak Gupta`} description={summary ?? description}>
  <!-- THESIS: Show decisions and operating boundaries before the long-form write-up.
    OWN-WORLD: Sharp, monochrome notebook with inspectable diagrams and real metadata.
    STORY: Understand the problem, follow the mechanism, inspect choices and evidence.
    FIRST VIEWPORT: Project title, personal scope, and a meaningful system artifact.
    FORM: User-approved visual case study with progressively disclosed detail. -->
  <article class="site-shell">
    <header class="case-heading">
      <a href="/work" class="text-link">&larr; All work</a>
      <h1>{isReview ? 'A useful first review. Not another wall of comments.' : title}</h1>
      <p>{summary ?? description}</p>
      <div class="metadata mt-5">
        {isReview && <span>{title}</span>}
        {client && <span>{client}</span>}
        {duration && <span>{duration}</span>}
        {status && <span>{status === 'production' ? 'In production' : status === 'built' ? 'Built for the team' : 'Experiment'}</span>}
      </div>
    </header>

    <div class:list={['case-overview', { 'case-overview--text': !visual }]}>
      <div class="case-scope">
        <h2>{problem ? 'The friction I saw' : 'My part in the work'}</h2>
        <p>{problem ?? contribution ?? description}</p>
        <dl>
          <div><dt>My scope</dt><dd>{contribution ?? role}</dd></div>
          {outcome && <div><dt>The useful change</dt><dd>{outcome}</dd></div>}
          <div><dt>Built with</dt><dd>{tags.join(' / ')}</dd></div>
        </dl>
      </div>
      {visual && <ProjectVisual kind={visual} />}
    </div>

    {isReview && <ReviewSystem />}

    {facts && facts.length > 0 && (
      <section class="case-section" aria-labelledby="system-facts">
        <h2 id="system-facts">System facts</h2>
        <dl class="results-list">{facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl>
      </section>
    )}

    <div class="case-body">
      <nav class="case-contents" aria-label="Case study contents">
        {isReview && <a href="#system">System & decisions</a>}
        {headings.filter((heading) => heading.depth === 2).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
        {metrics && metrics.length > 0 && <a href="#reported-results">Reported results</a>}
      </nav>
      <div class="case-writing"><Content /></div>
    </div>

    {metrics && metrics.length > 0 && (
      <section class="case-section mt-12" id="reported-results">
        <h2>Reported results</h2>
        <p>Figures from the original project write-up, not a live dashboard. The measurement period and evaluation methodology are not included in this public case study.</p>
        <dl class="results-list">{metrics.map((metric) => <div><dt>{metric.label}</dt><dd>{metric.value}</dd></div>)}</dl>
      </section>
    )}
    <div class="section-rule text-links"><a href="/work">Explore more work &rarr;</a><a href="/playground">Try a small experiment &rarr;</a></div>
  </article>
</Layout>
